BSC_LOG_RPC_URL=
PINATA_JWT=
SUPABASE_URL=
# Server-only Supabase secret/service-role key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Single wallet authorized for platform management signatures.
