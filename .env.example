NEXT_PUBLIC_BNBX_DEPLOYMENT_BLOCK=112395295
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional public IPFS gateway root, without a trailing slash.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Server-side secrets (never expose with NEXT_PUBLIC_)
