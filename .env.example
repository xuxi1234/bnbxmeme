DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bnbx
REDIS_URL=redis://localhost:6379

# Deployment keys must be supplied by a secure secret manager.
DEPLOYER_PRIVATE_KEY=
BSC_SCAN_API_KEY=

