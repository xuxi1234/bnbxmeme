# Public client configuration only
NEXT_PUBLIC_CHAIN_ID=56
# Active V3 factories. Standard remains blank until its mainnet deployment;
# the web app keeps every hard-coded V1/V2 factory read-only.
NEXT_PUBLIC_BNBX_FACTORY_ADDRESS=
NEXT_PUBLIC_BNBX_REWARDS_FACTORY_ADDRESS=0xef95ead95292408090e61112580f62e4d556c550
# Optional historical override only; no new auto-liquidity template is exposed.
NEXT_PUBLIC_BNBX_AUTO_LIQUIDITY_FACTORY_ADDRESS=0x9f572dc9d582ec8347d2a803f766652982220539
NEXT_PUBLIC_BNBX_DEPLOYMENT_BLOCK=112395295
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional public IPFS gateway root, without a trailing slash.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Server-side secrets (never expose with NEXT_PUBLIC_)
BSC_MAINNET_RPC_URL=
# Archive-capable endpoint for historical eth_getLogs scans.
BSC_LOG_RPC_URL=
PINATA_JWT=
SUPABASE_URL=
# Server-only Supabase secret/service-role key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Single wallet authorized for platform management signatures.
BNBX_ADMIN_SIGNING_WALLET=0xbE37AB912De351B9312FA593C9f99e3279FDB0a2
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bnbx
REDIS_URL=redis://localhost:6379

# Deployment keys must be supplied by a secure secret manager.
DEPLOYER_PRIVATE_KEY=
BSC_SCAN_API_KEY=
